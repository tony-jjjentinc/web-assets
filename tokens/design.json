{
  "font-family": "'Inter', 'Inter Fallback', system-ui, sans-serif",
  "font-family-raw": "Inter",
  "border-radius": "0.45rem",
  "enable-shadows": true,
  "btn-box-shadow": "none",
  "min-contrast-ratio": 4.5,
  "color-contrast-dark": "#191C1F",
  "color-contrast-light": "#F8F9FA",
  "subtle-bg-tint-weight": 75,
  "subtle-border-tint-weight": 75,
  "subtle-bg-shade-weight": 75,
  "subtle-border-shade-weight": 75,
  "faint-bg-tint-weight": 20,
  "faint-border-tint-weight": 20,
  "faint-bg-shade-weight": 20,
  "faint-border-shade-weight": 20,
  "shaded-bg-shade-weight": 35,
  "shaded-border-shade-weight": 35,
  "base-bg-tint-strength": 40,
  "base-bg-shade-strength": 40,
  "body-bg-tint-weight": 93,
  "body-border-tint-weight": 88,
  "body-bg-shade-weight": 92,
  "body-border-shade-weight": 85,
  "enable-gradient-noise": true,
  "gradient-noise-opacity": 0.06,
  "override-bootstrap-spinner": false,
  "gradient-tint-weight": 75,
  "dark-emphasis-tint-weight": 40,
  "light-emphasis-shade-weight": 60,
  "accessible-shade-start": 40,
  "dark-surface": "#212529"
}
